DJANGO_SECRET_KEY=run-python-scripts-configure.py
CREDENTIAL_KEY=run-python-scripts-configure.py
POSTGRES_PASSWORD=run-python-scripts-configure.py
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_DAILY_CALL_LIMIT=100
GROQ_API_KEY=
# Public HTTPS hostname, configured by scripts/set_public_url.py.
APP_DOMAIN=
# Optional free HTTPS tunnel. Blank until an ngrok account is configured.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
# Optional legacy OpenAI provider; never used as an automatic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:8080
HTTPS=0
SPARK_MASTER=local[2]
SPARK_PARTITIONS=8
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
CSV_MULTILINE=true
MAX_SOURCE_BYTES=5368709120
MAX_EXCEL_BYTES=104857600
FLOWER_USER=operator
FLOWER_PASSWORD=run-python-scripts-configure.py
